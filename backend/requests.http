@baseUrl = http://localhost:3000/api
@email = test_user@example.com
@password = secret_password

### 1. Signup
# @name signup
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Test User"
}

### 2. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Store token
@token = {{login.response.body.token}}

### 3. Get Current User (Me)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 4. Create Organization
# @name createOrg
POST {{baseUrl}}/orgs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "My New Startup"
}

### Store org ID
@orgId = {{createOrg.response.body.id}}

### 5. List My Organizations
GET {{baseUrl}}/orgs?page=1&limit=10
Authorization: Bearer {{token}}

### 6. Create Project in Organization
# @name createProject
POST {{baseUrl}}/orgs/{{orgId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Project Alpha"
}

### Store project ID
@projectId = {{createProject.response.body.id}}

### 7. List Projects in Organization
GET {{baseUrl}}/orgs/{{orgId}}/projects?page=1&limit=10
Authorization: Bearer {{token}}

### 8. Get Project by ID
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

### 9. Delete Project
DELETE {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{token}}

### 10. Validation Error Test (Empty body to create Org)
POST {{baseUrl}}/orgs
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 11. Create Queue in Project
# @name createQueue
POST {{baseUrl}}/projects/{{projectId}}/queues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "High Priority Emails",
  "priority": 10,
  "concurrencyLimit": 5,
  "retryPolicy": {
    "strategy": "EXPONENTIAL",
    "baseDelayMs": 1000,
    "maxRetries": 5
  }
}

### Store Queue ID
@queueId = {{createQueue.response.body.id}}

### 12. List Queues in Project
GET {{baseUrl}}/projects/{{projectId}}/queues?page=1&limit=10
Authorization: Bearer {{token}}

### 13. Get Queue Details (Live Stats)
GET {{baseUrl}}/queues/{{queueId}}
Authorization: Bearer {{token}}

### 14. Update Queue Config
PATCH {{baseUrl}}/queues/{{queueId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "concurrencyLimit": 20
}

### 15. Pause Queue
POST {{baseUrl}}/queues/{{queueId}}/pause
Authorization: Bearer {{token}}

### 16. Resume Queue
POST {{baseUrl}}/queues/{{queueId}}/resume
Authorization: Bearer {{token}}

### 17. Queue Metrics
GET {{baseUrl}}/queues/{{queueId}}/metrics
Authorization: Bearer {{token}}

### 18. Delete Queue
DELETE {{baseUrl}}/queues/{{queueId}}
Authorization: Bearer {{token}}

###############################################
#              JOB ENDPOINTS                  #
###############################################

### 19. Create Immediate Job (With Idempotency Key)
# @name createImmediateJob
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: test-key-12345

{
  "type": "email.send",
  "payload": { "to": "user@example.com", "subject": "Hello" },
  "mode": "immediate"
}

### Store Job ID
@jobId = {{createImmediateJob.response.body.id}}

### 20. Resend Same Immediate Job (Should return 200 OK, not 201 Created)
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: test-key-12345

{
  "type": "email.send",
  "payload": { "to": "user@example.com", "subject": "Hello" },
  "mode": "immediate"
}

### 21. Create Delayed Job (5 seconds)
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "report.generate",
  "payload": { "reportId": 42 },
  "mode": "delayed",
  "delayMs": 5000
}

### 22. Create Scheduled Job
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "invoice.send",
  "payload": { "invoiceId": 100 },
  "mode": "scheduled",
  "runAt": "2026-12-31T23:59:00Z"
}

### 23. Create Recurring Job (every 5 minutes)
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "metrics.collect",
  "payload": { "source": "api" },
  "mode": "recurring",
  "cronExpression": "*/5 * * * *"
}

### 24. Create Batch Jobs
POST {{baseUrl}}/queues/{{queueId}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "notification.push",
  "mode": "batch",
  "jobs": [
    { "payload": { "userId": 1, "msg": "Hello 1" } },
    { "payload": { "userId": 2, "msg": "Hello 2" } },
    { "payload": { "userId": 3, "msg": "Hello 3" } }
  ]
}

### 25. List Jobs in Queue (with pagination and filters)
GET {{baseUrl}}/queues/{{queueId}}/jobs?page=1&limit=10&status=QUEUED&type=email.send
Authorization: Bearer {{token}}

### 26. Get Job Detail (includes executions, logs)
GET {{baseUrl}}/jobs/{{jobId}}
Authorization: Bearer {{token}}

### 27. Retry a Failed Job
POST {{baseUrl}}/jobs/{{jobId}}/retry
Authorization: Bearer {{token}}

### 28. Cancel/Delete a Job
DELETE {{baseUrl}}/jobs/{{jobId}}
Authorization: Bearer {{token}}

### 29. 404 Error Test (Queue not found)
GET {{baseUrl}}/queues/invalid-queue-id
Authorization: Bearer {{token}}
